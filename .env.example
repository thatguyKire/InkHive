# Copy to .env and fill in. Everything is optional for local development:
# the app uses SQLite (db.sqlite3) and stores uploads in ./media by default.

# --- Django ---
# Production REQUIRES a random key of 50+ characters (the app refuses to start otherwise):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Extra comma-separated hosts (Render's own hostname is added automatically)
ALLOWED_HOSTS=
LOG_LEVEL=INFO

# --- Security (production) ---
# Move the Django admin away from the well-known /admin/ path
# ADMIN_URL=manage-7f3k9q/
# Trust X-Forwarded-* headers. Automatic on Render; only enable behind a real proxy.
# BEHIND_PROXY=False
# HTTPS redirect and HSTS (on by default when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000

# --- Storage locations ---
# On Render, mount a persistent disk (e.g. at /var/data) and point these at it,
# otherwise the database and uploads are wiped on every deploy/restart.
# SQLITE_PATH=/var/data/db.sqlite3
# MEDIA_ROOT=/var/data/media

# --- Optional: use PostgreSQL instead of SQLite ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
